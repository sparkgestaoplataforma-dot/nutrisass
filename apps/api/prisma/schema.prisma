generator client {
  provider = "prisma-client-js"
  output = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  NUTRICIONISTA
  SECRETARIA
}

enum Sexo {
  MASCULINO
  FEMININO
}

enum TipoAgendamento {
  CONSULTA
  RETORNO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMOU
  PRESENTE
  ENCAIXE
  CANCELADO
  NAO_COMPARECEU
  REALIZADO
  DESISTIU
  REMARCOU
}

enum TipoQuestao {
  TEXTO
  BOOLEANO
  NUMERICO
  ESCALA
  MULTIPLA_ESCOLHA
  CHECKBOX
}

model Clinica {
  id           String        @id @default(uuid())
  nome         String
  cnpj         String?       @unique
  telefone     String?
  email        String?
  endereco     String?
  logomarca    String?
  ativa        Boolean       @default(true)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  usuarios     Usuario[]
  pacientes    Paciente[]
  convenios    Convenio[]
  agendamentos Agendamento[]
  questionarios Questionario[]
  examesBase   ExameBase[]

  @@map("clinicas")
}

model Usuario {
  id           String        @id @default(uuid())
  clinicaId    String        @map("clinica_id")
  clinica      Clinica       @relation(fields: [clinicaId], references: [id])
  nome         String
  email        String        @unique
  senha        String
  perfil       Perfil
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  agendamentos Agendamento[]

  @@index([clinicaId])
  @@map("usuarios")
}

model Paciente {
  id               String                 @id @default(uuid())
  clinicaId        String                 @map("clinica_id")
  clinica          Clinica                @relation(fields: [clinicaId], references: [id])
  nome             String
  email            String?
  telefone         String?
  whatsapp         String?
  sexo             Sexo?
  dataNascimento   DateTime?              @map("data_nascimento")
  identidade       String?
  ufIdentidade     String?                @map("uf_identidade")
  orgaoExpedidor   String?                @map("orgao_expedidor")
  cpf              String?
  endereco         String?
  bairro           String?
  municipio        String?
  uf               String?
  cep              String?
  profissao        String?
  escolaridade     String?
  nomeMae          String?                @map("nome_mae")
  convenioId       String?                @map("convenio_id")
  convenio         Convenio?              @relation(fields: [convenioId], references: [id])
  numeroCarteira   String?                @map("numero_carteira")
  validadeCarteira DateTime?              @map("validade_carteira")
  criadoEm         DateTime               @default(now()) @map("criado_em")
  atualizadoEm     DateTime               @updatedAt @map("atualizado_em")
  agendamentos     Agendamento[]
  evolucoes        EvolucaoClinica[]
  medidas          Medida[]
  solicitacoes     SolicitacaoExame[]
  respostasQuestionarios Resposta[]

  @@index([clinicaId])
  @@map("pacientes")
}

model Convenio {
  id           String        @id @default(uuid())
  clinicaId    String        @map("clinica_id")
  clinica      Clinica       @relation(fields: [clinicaId], references: [id])
  nome         String
  registroANS  String?       @map("registro_ans")
  logomarca    String?
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  pacientes    Paciente[]
  agendamentos Agendamento[]

  @@index([clinicaId])
  @@map("convenios")
}

model Agendamento {
  id          String             @id @default(uuid())
  clinicaId   String             @map("clinica_id")
  clinica     Clinica            @relation(fields: [clinicaId], references: [id])
  pacienteId  String             @map("paciente_id")
  paciente    Paciente           @relation(fields: [pacienteId], references: [id])
  usuarioId   String             @map("usuario_id")
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  convenioId  String?            @map("convenio_id")
  convenio    Convenio?          @relation(fields: [convenioId], references: [id])
  dataHora    DateTime           @map("data_hora")
  tipo        TipoAgendamento
  status      StatusAgendamento  @default(AGENDADO)
  encaixe     Boolean            @default(false)
  observacao  String?
  criadoEm    DateTime           @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  @@index([clinicaId])
  @@index([dataHora])
  @@index([pacienteId])
  @@index([usuarioId])
  @@map("agendamentos")
}

model EvolucaoClinica {
  id                   String   @id @default(uuid())
  pacienteId           String   @map("paciente_id")
  paciente             Paciente @relation(fields: [pacienteId], references: [id])
  estadoClinico        String?  @map("estado_clinico")
  aparelhoDigestivo    String?  @map("aparelho_digestivo")
  antecedentesMorbidos String?  @map("antecedentes_morbidos")
  medicamentos         String?
  outros               String?
  criadoEm             DateTime @default(now()) @map("criado_em")

  @@index([pacienteId])
  @@map("evolucoes_clinicas")
}

model Medida {
  id            String   @id @default(uuid())
  pacienteId    String   @map("paciente_id")
  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  data          DateTime
  peso          Float?
  altura        Float?
  cintura       Float?
  abdomen       Float?
  quadril       Float?
  bracoDireito  Float?   @map("braco_direito")
  bracoEsquerdo Float?   @map("braco_esquerdo")
  coxaDireita   Float?   @map("coxa_direita")
  coxaEsquerda  Float?   @map("coxa_esquerda")
  culote        Float?
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@index([pacienteId])
  @@map("medidas")
}

model Questionario {
  id           String               @id @default(uuid())
  clinicaId    String               @map("clinica_id")
  clinica      Clinica              @relation(fields: [clinicaId], references: [id])
  titulo       String
  descricao    String?
  ativo        Boolean              @default(true)
  criadoEm     DateTime             @default(now()) @map("criado_em")
  atualizadoEm DateTime             @updatedAt @map("atualizado_em")
  versoes      QuestionarioVersao[]

  @@index([clinicaId])
  @@map("questionarios")
}

model QuestionarioVersao {
  id             String      @id @default(uuid())
  questionarioId String      @map("questionario_id")
  questionario   Questionario @relation(fields: [questionarioId], references: [id])
  versao         Int
  ativo          Boolean     @default(true)
  criadoEm       DateTime    @default(now()) @map("criado_em")
  modulos        Modulo[]
  respostas      Resposta[]

  @@unique([questionarioId, versao])
  @@index([questionarioId])
  @@map("questionarios_versoes")
}

model Modulo {
  id                   String              @id @default(uuid())
  questionarioVersaoId String              @map("questionario_versao_id")
  questionarioVersao   QuestionarioVersao  @relation(fields: [questionarioVersaoId], references: [id], onDelete: Cascade)
  titulo               String
  ordem                Int
  questoes             Questao[]

  @@index([questionarioVersaoId])
  @@unique([questionarioVersaoId, ordem])
  @@map("questionarios_modulos")
}

model Questao {
  id          String         @id @default(uuid())
  moduloId    String         @map("modulo_id")
  modulo      Modulo         @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  enunciado   String
  tipo        TipoQuestao
  obrigatoria Boolean        @default(false)
  ordem       Int
  opcoes      QuestaoOpcao[]
  respostas   RespostaItem[]

  @@index([moduloId])
  @@unique([moduloId, ordem])
  @@map("questionarios_questoes")
}

model QuestaoOpcao {
  id        String              @id @default(uuid())
  questaoId String              @map("questao_id")
  questao   Questao             @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  texto     String
  valor     Float?
  ordem     Int
  respostas RespostaItemOpcao[]

  @@index([questaoId])
  @@unique([questaoId, ordem])
  @@map("questionarios_questoes_opcoes")
}

model Resposta {
  id                   String             @id @default(uuid())
  questionarioVersaoId String             @map("questionario_versao_id")
  questionarioVersao   QuestionarioVersao @relation(fields: [questionarioVersaoId], references: [id])
  pacienteId           String             @map("paciente_id")
  paciente             Paciente           @relation(fields: [pacienteId], references: [id])
  criadoEm             DateTime           @default(now()) @map("criado_em")
  itens                RespostaItem[]

  @@index([questionarioVersaoId])
  @@index([pacienteId])
  @@map("questionarios_respostas")
}

model RespostaItem {
  id            String              @id @default(uuid())
  respostaId    String              @map("resposta_id")
  resposta      Resposta            @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  questaoId     String              @map("questao_id")
  questao       Questao             @relation(fields: [questaoId], references: [id])
  valorTexto    String?             @map("valor_texto")
  valorNumero   Float?              @map("valor_numero")
  valorBooleano Boolean?            @map("valor_booleano")
  opcoes        RespostaItemOpcao[]

  @@index([respostaId])
  @@index([questaoId])
  @@map("questionarios_respostas_itens")
}

model RespostaItemOpcao {
  id             String       @id @default(uuid())
  respostaItemId String       @map("resposta_item_id")
  respostaItem   RespostaItem @relation(fields: [respostaItemId], references: [id], onDelete: Cascade)
  questaoOpcaoId String       @map("questao_opcao_id")
  questaoOpcao   QuestaoOpcao @relation(fields: [questaoOpcaoId], references: [id])

  @@index([respostaItemId])
  @@index([questaoOpcaoId])
  @@map("questionarios_respostas_itens_opcoes")
}

model ExameBase {
  id          String                 @id @default(uuid())
  clinicaId   String                 @map("clinica_id")
  clinica     Clinica                @relation(fields: [clinicaId], references: [id])
  codigo      String
  nome        String
  valorMinimo Float?                 @map("valor_minimo")
  valorMaximo Float?                 @map("valor_maximo")
  unidade     String?
  criadoEm    DateTime               @default(now()) @map("criado_em")
  itens       SolicitacaoExameItem[]

  @@unique([clinicaId, codigo])
  @@index([clinicaId])
  @@map("exames_base")
}

model SolicitacaoExame {
  id             String                 @id @default(uuid())
  pacienteId     String                 @map("paciente_id")
  paciente       Paciente               @relation(fields: [pacienteId], references: [id])
  dataSolicitada DateTime               @default(now()) @map("data_solicitada")
  itens          SolicitacaoExameItem[]

  @@index([pacienteId])
  @@map("solicitacoes_exames")
}

model SolicitacaoExameItem {
  id             String           @id @default(uuid())
  solicitacaoId  String           @map("solicitacao_id")
  solicitacao    SolicitacaoExame @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  exameBaseId    String           @map("exame_base_id")
  exameBase      ExameBase        @relation(fields: [exameBaseId], references: [id])
  dataResultado  DateTime?        @map("data_resultado")
  resultado      String?

  @@map("solicitacoes_exames_itens")
}
