# Database (PostgreSQL do docker-compose.yml ou Railway)
DATABASE_URL="postgresql://nutricao:nutricao@localhost:5432/nutricao?schema=public"

# Redis (docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Config
API_PORT=3333
NODE_ENV="development"

# Cloudflare R2 (Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME="nutricao"
R2_PUBLIC_URL=
